<script>
    function switchInfoTab(tabId) {
        const overviewBtn = document.getElementById("tabBtnOverview");
        const techBtn = document.getElementById("tabBtnTech");
        const overviewPanel = document.getElementById("tabPanelOverview");
        const techPanel = document.getElementById("tabPanelTech");

        if (tabId === "overview") {
            overviewBtn.classList.add("active");
            techBtn.classList.remove("active");
            overviewPanel.classList.add("active");
            techPanel.classList.remove("active");
        } else {
            techBtn.classList.add("active");
            overviewBtn.classList.remove("active");
            techPanel.classList.add("active");
            overviewPanel.classList.remove("active");
        }
    }
</script>


