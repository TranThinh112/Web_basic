@{
    Layout = "~/Frontend/Views/Shared/AuthLayout.cshtml";
    ViewData["Title"] = "About BunnyChat - Về Chúng Tôi";
}

<style>
    .info-container {
        width: min(860px, 94vw);
        max-height: 86vh;
        overflow-y: auto;
        padding: 32px 36px;
        margin: 20px auto;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
        color: #1e1b4b;
        scrollbar-width: thin;
        scrollbar-color: #8b5cf6 rgba(255, 255, 255, 0.3);
    }

    .info-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 24px;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
    }

    .info-header img {
        width: 64px;
        height: auto;
    }

    .info-header h1 {
        font-size: 28px;
        font-weight: 800;
        margin: 0;
        color: #312e81;
    }

    .info-header p {
        margin: 4px 0 0;
        font-size: 14px;
        color: #4338ca;
        font-weight: 600;
    }

    .info-section {
        margin-bottom: 24px;
    }

    .info-section h2 {
        font-size: 18px;
        font-weight: 700;
        color: #4338ca;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-section h2 i {
        color: #7c3aed;
    }

    .info-section p {
        font-size: 14.5px;
        line-height: 1.6;
        color: #334155;
        margin-bottom: 12px;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
        margin-top: 10px;
    }

    .feature-item {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(139, 92, 246, 0.25);
        border-radius: 14px;
        padding: 14px 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .feature-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.15);
    }

    .feature-item strong {
        display: block;
        color: #1e1b4b;
        font-size: 14.5px;
        margin-bottom: 6px;
    }

    .feature-item p {
        font-size: 13px;
        color: #64748b;
        margin: 0;
        line-height: 1.45;
    }

    .tech-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    .tech-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ede9fe;
        color: #5b21b6;
        border: 1px solid #ddd6fe;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .info-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: 28px;
        padding-top: 18px;
        border-top: 1px solid rgba(139, 92, 246, 0.2);
    }

    /* Tối ưu chống chớp nháy phần cứng */
    .info-container {
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
        will-change: transform;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .start-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #6d28d9, #8b5cf6);
        color: #ffffff !important;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 8px 18px rgba(109, 40, 217, 0.35);
        transition: transform 0.2s ease;
    }

    .start-btn:hover {
        transform: scale(1.04);
        box-shadow: 0 10px 24px rgba(109, 40, 217, 0.45);
    }

    .back-link {
        color: #4338ca;
        font-weight: 700;
        text-decoration: none;
        font-size: 14.5px;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    @@media (max-width: 600px) {
        .info-container {
            padding: 22px 18px;
            max-height: 88vh;
        }
        .info-header h1 {
            font-size: 22px;
        }
        .info-actions {
            flex-direction: column-reverse;
            gap: 14px;
            align-items: stretch;
            text-align: center;
        }
        .start-btn {
            justify-content: center;
        }
    }
</style>

<div class="auth-page">
    <div class="info-container">
        <header class="info-header">
            <img src="/images/Logo.png" alt="BunnyChat Logo" />
            <div>
                <h1>BunnyChat</h1>
                <p>Nền tảng trò chuyện trực tuyến thời gian thực (Realtime Web Chat)</p>
            </div>
        </header>

        <section class="info-section">
            <h2><i class="bi bi-info-circle-fill"></i> Giới Thiệu Dự Án</h2>
            <p>
                <strong>BunnyChat</strong> là ứng dụng nhắn tin trực tuyến thời gian thực hiện đại, được xây dựng với mục tiêu mang lại trải nghiệm giao tiếp tức thì, mượt mà và an toàn cho người dùng trên nền tảng Web.
            </p>
            <p>
                Dự án tích hợp đầy đủ các chức năng trò chuyện cá nhân (1-1), trò chuyện nhóm (Group Chat), kết bạn linh hoạt, cùng bộ tính năng tương tác phong phú như tìm kiếm nội dung tin nhắn và thả cảm xúc (Reactions) chuẩn phong cách mạng xã hội.
            </p>
        </section>

        <section class="info-section">
            <h2><i class="bi bi-stars"></i> Tính Năng Nổi Bật</h2>
            <div class="feature-grid">
                <div class="feature-item">
                    <strong>💬 Nhắn Tin Thời Gian Thực</strong>
                    <p>Trao đổi thông điệp tức thời thông qua giao thức SignalR WebSockets hai chiều, độ trễ cực thấp.</p>
                </div>
                <div class="feature-item">
                    <strong>❤️ Thả Cảm Xúc (Reactions)</strong>
                    <p>Thả và đổi biểu tượng cảm xúc (Like, Love, Haha, Wow, Sad, Angry) tương tác trực tiếp trên từng tin nhắn.</p>
                </div>
                <div class="feature-item">
                    <strong>🔍 Tìm Kiếm Thông Minh</strong>
                    <p>Tìm kiếm tin nhắn nhanh trong đoạn chat đang mở hoặc tra cứu trên toàn bộ lịch sử các cuộc trò chuyện.</p>
                </div>
                <div class="feature-item">
                    <strong>👥 Quản Lý Bạn Bè & Nhóm</strong>
                    <p>Tìm kiếm người dùng, gửi/nhận lời mời kết bạn và dễ dàng tạo các nhóm chat thảo luận cùng bạn bè.</p>
                </div>
                <div class="feature-item">
                    <strong>🌗 Giao Diện Dark / Light Mode</strong>
                    <p>Hỗ trợ chuyển đổi chế độ Sáng/Tối linh hoạt kèm thiết kế Glassmorphism và tối ưu hiển thị trên Mobile.</p>
                </div>
                <div class="feature-item">
                    <strong>🛡️ Bảo Mật & Xác Thực</strong>
                    <p>Bảo mật phiên bằng JWT (JSON Web Token), mã hóa mật khẩu BCrypt và luồng khôi phục tài khoản tiện lợi.</p>
                </div>
            </div>
        </section>

        <section class="info-section">
            <h2><i class="bi bi-code-slash"></i> Công Nghệ Nền Tảng</h2>
            <div class="tech-badges">
                <span class="tech-pill"><i class="bi bi-cpu"></i> ASP.NET Core (.NET 8/10)</span>
                <span class="tech-pill"><i class="bi bi-broadcast-pin"></i> Microsoft SignalR (WebSockets)</span>
                <span class="tech-pill"><i class="bi bi-database"></i> MongoDB Atlas (NoSQL)</span>
                <span class="tech-pill"><i class="bi bi-shield-lock"></i> JWT Authentication & BCrypt</span>
                <span class="tech-pill"><i class="bi bi-filetype-html"></i> Razor Pages & Modular JavaScript</span>
                <span class="tech-pill"><i class="bi bi-palette"></i> Modern Glassmorphism CSS</span>
            </div>
        </section>

        <div class="info-actions">
            
            <a href="/" class="start-btn">Trải nghiệm ngay <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</div>
