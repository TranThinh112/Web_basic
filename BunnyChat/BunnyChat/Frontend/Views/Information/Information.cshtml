@{
    Layout = "~/Frontend/Views/Shared/AuthLayout.cshtml";
    ViewData["Title"] = "Tài Liệu Kỹ Thuật & Giới Thiệu - BunnyChat";
}

<style>
    .info-container {
        width: min(1060px, 95vw);
        max-height: 88vh;
        overflow-y: auto;
        padding: 30px 36px;
        margin: 15px auto;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
        color: #1e1b4b;
        scrollbar-width: thin;
        scrollbar-color: #8b5cf6 rgba(255, 255, 255, 0.3);
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
    }

    .info-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
    }

    .header-brand {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .info-header img {
        width: 60px;
        height: auto;
    }

    .info-header h1 {
        font-size: 26px;
        font-weight: 800;
        margin: 0;
        color: #312e81;
    }

    .info-header p {
        margin: 4px 0 0;
        font-size: 13.5px;
        color: #4338ca;
        font-weight: 600;
    }

    .back-login-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 12px;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        color: #ffffff !important;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 700;
        box-shadow: 0 4px 14px rgba(124, 58, 237, 0.3);
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .back-login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(124, 58, 237, 0.45);
        color: #ffffff !important;
        background: linear-gradient(135deg, #6d28d9, #7e22ce);
    }

    /* Tab bar điều hướng */
    .nav-tabs-custom {
        display: flex;
        gap: 8px;
        background: rgba(139, 92, 246, 0.08);
        padding: 6px;
        border-radius: 14px;
        margin-bottom: 24px;
        border: 1px solid rgba(139, 92, 246, 0.15);
    }

    .tab-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border: none;
        background: transparent;
        color: #475569;
        font-weight: 700;
        font-size: 14px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .tab-btn:hover {
        color: #5b21b6;
        background: rgba(255, 255, 255, 0.5);
    }

    .tab-btn.active {
        color: #4338ca;
        background: #ffffff;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.18);
    }

    .tab-content-panel {
        display: none;
        animation: fadeInTab 0.25s ease-out;
    }

    .tab-content-panel.active {
        display: block;
    }

    @@keyframes fadeInTab {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .info-section {
        margin-bottom: 24px;
    }

    .info-section h2 {
        font-size: 17.5px;
        font-weight: 700;
        color: #4338ca;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-section p {
        font-size: 14px;
        line-height: 1.6;
        color: #334155;
        margin-bottom: 10px;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 14px;
        margin-top: 10px;
    }

    .feature-item {
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(139, 92, 246, 0.25);
        border-radius: 14px;
        padding: 14px 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .feature-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.15);
    }

    .feature-item strong {
        display: block;
        color: #1e1b4b;
        font-size: 14.5px;
        margin-bottom: 6px;
    }

    .feature-item p {
        font-size: 13px;
        color: #64748b;
        margin: 0;
        line-height: 1.45;
    }

    .tech-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    .tech-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ede9fe;
        color: #5b21b6;
        border: 1px solid #ddd6fe;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    /* Thiết kế thẻ Card Kỹ Thuật (Architecture Cards) */
    .arch-card {
        background: #ffffff;
        border: 1px solid rgba(139, 92, 246, 0.22);
        border-radius: 16px;
        padding: 18px 20px;
        margin-bottom: 18px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }

    .arch-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 700;
        color: #312e81;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px dashed rgba(139, 92, 246, 0.25);
    }

    .flow-step-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 10px 0;
    }

    .flow-step-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 13.5px;
        line-height: 1.5;
        color: #334155;
    }

    .step-badge {
        flex: 0 0 24px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #6366f1;
        color: #ffffff;
        display: grid;
        place-items: center;
        font-size: 11px;
        font-weight: 800;
    }

    /* Schema Table Styling */
    .table-responsive-custom {
        overflow-x: auto;
        margin: 10px 0;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .schema-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        text-align: left;
    }

    .schema-table th {
        background: #f1f5f9;
        color: #1e293b;
        font-weight: 700;
        padding: 10px 14px;
        border-bottom: 1px solid #cbd5e1;
    }

    .schema-table td {
        padding: 9px 14px;
        border-bottom: 1px solid #f1f5f9;
        color: #475569;
    }

    .schema-table tr:last-child td {
        border-bottom: none;
    }

    .field-name {
        font-family: monospace;
        font-weight: 700;
        color: #6d28d9;
    }

    .field-type {
        font-family: monospace;
        color: #0284c7;
        font-size: 12px;
    }

    /* Sơ đồ quan hệ ERD Diagram dạng SVG/Visual Nodes */
    .erd-wrapper {
        background: #0f172a;
        color: #f8fafc;
        border-radius: 16px;
        padding: 22px;
        margin: 14px 0;
        box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    }

    .erd-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 16px;
    }

    .erd-node {
        background: #1e293b;
        border: 1.5px solid #334155;
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .erd-node:hover {
        border-color: #a855f7;
        transform: translateY(-2px);
    }

    .erd-node-title {
        background: #334155;
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 700;
        color: #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .erd-node-title span {
        font-size: 11px;
        background: rgba(168, 85, 247, 0.25);
        color: #d8b4fe;
        padding: 2px 6px;
        border-radius: 6px;
    }

    .erd-node-fields {
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        font-size: 12px;
        font-family: monospace;
    }

    .erd-field-row {
        display: flex;
        justify-content: space-between;
        color: #94a3b8;
    }

    .erd-field-row strong {
        color: #f1f5f9;
    }

    .erd-relations {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #334155;
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-size: 12.5px;
        color: #cbd5e1;
    }

    .rel-badge {
        display: inline-block;
        padding: 2px 7px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        margin-right: 6px;
    }

    .rel-1n { background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); }
    .rel-nn { background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.4); }

    @@media (max-width: 768px) {
        .info-container {
            padding: 20px 16px;
            max-height: 88vh;
        }
        .info-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .nav-tabs-custom {
            flex-direction: column;
        }
        .erd-grid {
            grid-template-columns: 1fr;
        }
        }
</style>

<div class="auth-page">
    <div class="info-container">
        <!-- Header -->
        <header class="info-header">
            <div class="header-brand">
                <img src="/images/Logo.png" alt="BunnyChat Logo" />
                <div>
                    <h1>BunnyChat</h1>
                    <p>Hệ thống trò chuyện trực tuyến thời gian thực & Kiến trúc phần mềm</p>
                </div>
            </div>
            <a href="/" class="back-login-btn">
                <i class="bi bi-box-arrow-in-right"></i> Về Đăng Nhập
            </a>
        </header>

        <!-- Tab Bar -->
        <div class="nav-tabs-custom">
            <button type="button" class="tab-btn active" id="tabBtnOverview" onclick="switchInfoTab('overview')">
                <i class="bi bi-info-circle-fill"></i> 1. Giới Thiệu & Tính Năng
            </button>
            <button type="button" class="tab-btn" id="tabBtnTech" onclick="switchInfoTab('tech')">
                <i class="bi bi-shield-lock-fill"></i> 2. Kiến Trúc, Auth & Database (ERD)
            </button>
        </div>

        <!-- TAB 1: TỔNG QUAN & TÍNH NĂNG -->
        <div class="tab-content-panel active" id="tabPanelOverview">
            <section class="info-section">
                <h2><i class="bi bi-info-circle-fill"></i> Giới Thiệu Dự Án</h2>
                <p>
                    <strong>BunnyChat</strong> là ứng dụng nhắn tin trực tuyến thời gian thực hiện đại, được xây dựng với mục tiêu mang lại trải nghiệm giao tiếp tức thì, mượt mà và an toàn cho người dùng trên nền tảng Web.
                </p>
                <p>
                    Dự án tích hợp đầy đủ các chức năng trò chuyện cá nhân (1-1), trò chuyện nhóm (Group Chat), kết bạn linh hoạt, cùng bộ tính năng tương tác phong phú như tìm kiếm nội dung tin nhắn và thả cảm xúc (Reactions) chuẩn phong cách mạng xã hội.
                </p>
            </section>

            <section class="info-section">
                <h2><i class="bi bi-stars"></i> Tính Năng Nổi Bật</h2>
                <div class="feature-grid">
                    <div class="feature-item">
                        <strong>💬 Nhắn Tin Realtime & Optimistic UI</strong>
                        <p>Tin nhắn xuất hiện tức thì 0ms trên giao diện người gửi, sau đó phát thời gian thực tới người nhận qua SignalR WebSockets.</p>
                    </div>
                    <div class="feature-item">
                        <strong>❤️ Thả Cảm Xúc (Messenger Reactions)</strong>
                        <p>Tương tác cảm xúc tức thì (👍 ❤️ 😂 😮 😢 😡), tự động cập nhật preview, và đưa đoạn chat vừa tương tác lên đầu danh sách.</p>
                    </div>
                    <div class="feature-item">
                        <strong>🔵 Chấm Tròn Xanh & Tin Chưa Đọc</strong>
                        <p>Đoạn chat có tin mới chưa đọc được làm nổi bật với chữ in đậm và chấm tròn xanh Messenger, tự động xóa khi mở xem.</p>
                    </div>
                    <div class="feature-item">
                        <strong>🔍 Tìm Kiếm In-Chat & Toàn Cục</strong>
                        <p>Tìm kiếm từ khóa trong chính đoạn chat đang mở hoặc quét nhanh trên toàn bộ lịch sử trò chuyện của tài khoản.</p>
                    </div>
                    <div class="feature-item">
                        <strong>👥 Kết Bạn & Chat Nhóm Động</strong>
                        <p>Tìm kiếm người dùng theo tên/username, gửi/chấp nhận lời mời kết bạn tức thời và tạo nhóm chat nhiều thành viên.</p>
                    </div>
                    <div class="feature-item">
                        <strong>⚙️ Cá Nhân Hóa & Đổi Màu Logo</strong>
                        <p>Chỉnh sửa hồ sơ (Họ tên, Nickname, Bio, SĐT), tùy biến bộ màu nhận diện BunnyChat và ghi nhớ vào LocalStorage.</p>
                    </div>
                    <div class="feature-item">
                        <strong>📜 Cuộn Tải Phân Trang (Cursor Pagination)</strong>
                        <p>Tải 50 tin nhắn mỗi lượt, tự động tải ngược lịch sử cũ khi cuộn lên đầu và lưu đệm tin nhắn cục bộ 0ms độ trễ.</p>
                    </div>
                    <div class="feature-item">
                        <strong>🛡️ Xác Thực JWT & Khôi Phục 2 Bước</strong>
                        <p>Hệ thống Session bảo mật với Refresh Token HttpOnly, BCrypt và quy trình khôi phục mật khẩu 2 bước chuẩn xác.</p>
                    </div>
                </div>
            </section>

            <section class="info-section">
                <h2><i class="bi bi-code-slash"></i> Công Nghệ Nền Tảng</h2>
                <div class="tech-badges">
                    <span class="tech-pill"><i class="bi bi-cpu"></i> ASP.NET Core (.NET 8/10)</span>
                    <span class="tech-pill"><i class="bi bi-broadcast-pin"></i> Microsoft SignalR (WebSockets)</span>
                    <span class="tech-pill"><i class="bi bi-database"></i> MongoDB Atlas (NoSQL)</span>
                    <span class="tech-pill"><i class="bi bi-shield-lock"></i> JWT Authentication & BCrypt</span>
                    <span class="tech-pill"><i class="bi bi-filetype-html"></i> Razor Pages & Modular JavaScript</span>
                    <span class="tech-pill"><i class="bi bi-palette"></i> Modern Glassmorphism CSS</span>
                </div>
            </section>
        </div>

        <!-- TAB 2: KIẾN TRÚC KỸ THUẬT, AUTHEN/AUTHOR & DATABASE ERD -->
        <div class="tab-content-panel" id="tabPanelTech">
            <!-- 1. Authentication & Authorization -->
            <div class="arch-card">
                <div class="arch-card-header">
                    <i class="bi bi-shield-check" style="color: #6366f1; font-size: 20px;"></i>
                    1. Cơ Chế Xác Thực (Authentication) & Phân Quyền (Authorization)
                </div>
                <div class="flow-step-list">
                    <div class="flow-step-item">
                        <span class="step-badge">1</span>
                        <div>
                            <strong>Cơ chế Authentication (Xác thực người dùng):</strong>
                            <p style="margin: 2px 0 0; color: #64748b; font-size: 13px;">
                                Sử dụng <strong>JWT (JSON Web Token)</strong> kết hợp <strong>BCrypt Password Hashing</strong>. Khi người dùng đăng nhập thành công, hệ thống cấp phát <code>AccessToken</code> (hạn dùng ngắn hạn: 45 phút, chứa Claims: UserId, Username, Email) và <code>RefreshToken</code> (7 ngày, lưu vào bảng Session trên MongoDB và gán Cookie HttpOnly).
                            </p>
                        </div>
                    </div>
                    <div class="flow-step-item">
                        <span class="step-badge">2</span>
                        <div>
                            <strong>Cơ chế Authorization (Kiểm soát quyền truy cập):</strong>
                            <p style="margin: 2px 0 0; color: #64748b; font-size: 13px;">
                                Áp dụng thuộc tính <code>[Authorize]</code> cấp Controller/Action. Đối với các tài nguyên nhạy cảm như cuộc trò chuyện, tin nhắn hay thêm thành viên, hệ thống triển khai lớp kiểm tra động (<strong>Data-level Authorization</strong> qua <code>ConversationHelper.IsParticipant</code>) để ngăn chặn truy cập trái phép. Nếu không thuộc thành viên, server lập tức trả về mã lỗi <code>403 Forbid</code>.
                            </p>
                        </div>
                    </div>
                    <div class="flow-step-item">
                        <span class="step-badge">3</span>
                        <div>
                            <strong>Tự động Refresh Token & Quên Mật Khẩu (Forgot Password):</strong>
                            <p style="margin: 2px 0 0; color: #64748b; font-size: 13px;">
                                Frontend sử dụng module bảo vệ <code>Protect_Chat.js</code> để tự động gửi request đến <code>/api/auth/refresh</code> khi AccessToken hết hạn. Luồng quên mật khẩu 2 bước: xác thực tài khoản/email và đặt lại mật khẩu mới được băm bảo mật bằng BCrypt.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Cơ sở dữ liệu & Sơ đồ ERD -->
            <div class="arch-card">
                <div class="arch-card-header">
                    <i class="bi bi-diagram-3-fill" style="color: #8b5cf6; font-size: 20px;"></i>
                    2. Sơ Đồ Thực Thể Quan Hệ (ERD Diagram - MongoDB Database)
                </div>
                <p style="font-size: 13.5px; color: #475569; margin-bottom: 12px;">
                    BunnyChat sử dụng cơ sở dữ liệu NoSQL <strong>MongoDB Atlas</strong> với mô hình lưu trữ tài liệu (Document-based) kết hợp tham chiếu liên kết (Referenced IDs) và tài liệu nhúng (Embedded Documents) nhằm tối ưu tốc độ đọc tin nhắn thời gian thực:
                </p>

                <!-- Visual ERD Grid -->
                <div class="erd-wrapper">
                    <div class="erd-grid">
                        <!-- Entity: User -->
                        <div class="erd-node">
                            <div class="erd-node-title">
                                <strong>👤 User</strong>
                                <span>Collection</span>
                            </div>
                            <div class="erd-node-fields">
                                <div class="erd-field-row"><span>_id (PK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>Username</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>Email</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>HashPassword</span><strong>string (BCrypt)</strong></div>
                                <div class="erd-field-row"><span>FirstName, LastName</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>AvatarUrl, Phone</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>CreatedAt</span><strong>DateTime</strong></div>
                            </div>
                        </div>

                        <!-- Entity: Conversation -->
                        <div class="erd-node">
                            <div class="erd-node-title">
                                <strong>💬 Conversation</strong>
                                <span>Collection</span>
                            </div>
                            <div class="erd-node-fields">
                                <div class="erd-field-row"><span>_id (PK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>Type</span><strong>direct | group</strong></div>
                                <div class="erd-field-row"><span>Participants[]</span><strong>[UserId, Joined]</strong></div>
                                <div class="erd-field-row"><span>Group</span><strong>{Name, CreatedBy}</strong></div>
                                <div class="erd-field-row"><span>LastMessage</span><strong>{Id, Content, Time}</strong></div>
                                <div class="erd-field-row"><span>UnreadCounts</span><strong>Dict&lt;Id, int&gt;</strong></div>
                                <div class="erd-field-row"><span>UpdatedAt</span><strong>DateTime</strong></div>
                            </div>
                        </div>

                        <!-- Entity: Message -->
                        <div class="erd-node">
                            <div class="erd-node-title">
                                <strong>✉️ Message</strong>
                                <span>Collection</span>
                            </div>
                            <div class="erd-node-fields">
                                <div class="erd-field-row"><span>_id (PK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>ConversationId (FK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>SenderId (FK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>Content</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>Reactions[]</span><strong>[UserId, Emoji]</strong></div>
                                <div class="erd-field-row"><span>CreatedAt</span><strong>DateTime</strong></div>
                            </div>
                        </div>

                        <!-- Entity: Friend -->
                        <div class="erd-node">
                            <div class="erd-node-title">
                                <strong>🤝 Friend</strong>
                                <span>Collection</span>
                            </div>
                            <div class="erd-node-fields">
                                <div class="erd-field-row"><span>_id (PK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>SenderId (FK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>ReceiveId (FK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>Status</span><strong>Enum (0..3)</strong></div>
                                <div class="erd-field-row"><span>Message</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>CreatedAt</span><strong>DateTime</strong></div>
                            </div>
                        </div>

                        <!-- Entity: Session -->
                        <div class="erd-node">
                            <div class="erd-node-title">
                                <strong>🔑 Session</strong>
                                <span>Collection</span>
                            </div>
                            <div class="erd-node-fields">
                                <div class="erd-field-row"><span>_id (PK)</span><strong>ObjectId</strong></div>
                                <div class="erd-field-row"><span>UserId (FK)</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>RefreshToken</span><strong>string</strong></div>
                                <div class="erd-field-row"><span>ExpiresAt</span><strong>DateTime</strong></div>
                            </div>
                        </div>
                    </div>

                    <!-- Quan hệ giữa các collection -->
                    <div class="erd-relations">
                        <div><span class="rel-badge rel-1n">1 : N</span> <strong>User ➔ Message:</strong> Một người dùng có thể gửi nhiều tin nhắn (SenderId).</div>
                        <div><span class="rel-badge rel-1n">1 : N</span> <strong>Conversation ➔ Message:</strong> Một cuộc trò chuyện chứa danh sách nhiều tin nhắn (ConversationId).</div>
                        <div><span class="rel-badge rel-nn">N : N</span> <strong>User ⇄ Conversation:</strong> Quan hệ nhiều - nhiều thông qua mảng nhúng <code>Participants</code> bên trong Conversation.</div>
                        <div><span class="rel-badge rel-nn">N : N</span> <strong>User ⇄ User (Friends):</strong> Kết nối bạn bè 2 chiều giữa <code>SenderId</code> và <code>ReceiveId</code> với trạng thái (Pending, Accepted, Rejected, Blocked).</div>
                    </div>
                </div>
            </div>

            <!-- 3. Luồng Realtime WebSockets (SignalR) -->
            <div class="arch-card">
                <div class="arch-card-header">
                    <i class="bi bi-broadcast" style="color: #ec4899; font-size: 20px;"></i>
                    3. Cơ Chế Thời Gian Thực (SignalR Realtime Hub)
                </div>
                <div class="table-responsive-custom">
                    <table class="schema-table">
                        <thead>
                            <tr>
                                <th>Kênh / Nhóm (Group)</th>
