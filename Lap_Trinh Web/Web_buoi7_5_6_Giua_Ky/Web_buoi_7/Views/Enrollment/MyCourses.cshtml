@model IEnumerable<Web_buoi_7.Models.Enrollment>

<h2>Học phần đã đăng ký</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên học phần</th>
            <th>Số tín chỉ</th>
            <th>Giảng viên</th>
            <th>Ngày đăng ký</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course.Name</td>
                <td>@item.Course.Credits</td>
                <td>@item.Course.Lecturer</td>
                <td>@item.EnrollDate.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Hủy đăng ký
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>