@model Web_buoi_7.Models.Course

<h2>Delete Course</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this course?
</div>

<div class="card">
    <div class="card-body">

        <h4>@Model.Name</h4>

        <p>
            Credits: @Model.Credits
        </p>

        <p>
            Lecturer: @Model.Lecturer
        </p>

        <img src="@Model.Image"
             width="200" />

    </div>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>