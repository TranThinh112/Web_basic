@model IEnumerable<Web_buoi_7.Models.Course>

@{
    ViewData["Title"] = "Danh sách học phần";
}

<h2>Danh sách sản phẩm</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Image</th>
            <th>Credits</th>
            <th>Lecturer</th>
            <th>CategoryId</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Id</td>
                <td>@course.Name</td>
                <td>@course.Image</td>
                <td>@course.Credits</td>
                <td>@course.Lecturer</td>
                <td>@course.CategoryId</td>
            </tr>
        }
    </tbody>
</table>